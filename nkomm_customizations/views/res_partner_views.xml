<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">Nkomm Partner Form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]" position="inside">
                <field name="digital_invoice" widget="boolean_toggle"
                       help="Möchte der Kunde Rechnungen digital erhalten?"/>
            </xpath>
            <xpath expr="//field[@name='title']" position="replace"/>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group invisible="is_company">
                    <group>
                        <field name="title" options="{&quot;no_open&quot;: True}" placeholder="e.g. Mister"
                               invisible="is_company"/>
                        <field name="first_name" placeholder="Vorname"/>
                        <field name="last_name" placeholder="Nachname"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="sequence_number" string="Kundennummer"/>
                <field name="x_studio_kurzname" string="Kurzname" help="Hier wird der Kurzname für ELO definiert"/>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='name']"
                   position="attributes">
                <attribute name="string">Full Name</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='name']"
                   position="before">
                <field name="title" options="{&quot;no_open&quot;: True}" placeholder="e.g. Mister"/>
                <field name="first_name" placeholder="Vorname"/>
                <field name="last_name" placeholder="Nachname"/>
            </xpath>

            <xpath expr="//field[@name='ref']" position="replace"/>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='title'][2]"
                   position="replace"/>
            <xpath expr="//form[1]/sheet[1]/div[not(@name)][1]/h1[1]/field[@name='name'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">(type == 'contact') or ((is_company == False) and (type == 'contact'))
                </attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='name']"
                   position="attributes">
                <attribute name="force_save">True</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="required">(type == 'contact') or (type == 'contact')</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">Nkomm Partner Tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='display_name']" position="before">
                <field name="sequence_number" string="Customer Number" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='display_name']" position="after">
                <field name="x_studio_kurzname" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="after">
                <field name="digital_invoice" optional="show"/>
                <field name="property_payment_term_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
